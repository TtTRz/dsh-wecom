# Copy to ~/.dsh/.env (or export in the launch environment) — never commit real values.
WECOM_BOT_ID=your-bot-id

# Store the Secret via the Harness credential surface under reference `WECOM_BOT_SECRET`
# instead of an environment variable. Development-only env fallback:
WECOM_BOT_SECRET=your-bot-secret

# Optional: override the agent working directory.
DSH_WECOM_CWD=/absolute/path/to/workspace
